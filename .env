# ==============================================================================
# Q10 ORDERFLOW - CONFIGURACIÓN DE DEPLOY Y VARIABLES DE ENTORNO
# Ninguna credencial o ruta está hardcodeada en el código principal.
# ==============================================================================

# PostgreSQL Configuración
POSTGRES_DB=q10_orderflow_db
POSTGRES_USER=q10_admin
POSTGRES_PASSWORD=secure_password_q10
DATABASE_URL=postgresql://q10_admin:secure_password_q10@postgres:5432/q10_orderflow_db

# RabbitMQ Configuración
RABBITMQ_DEFAULT_USER=rabbit_admin
RABBITMQ_DEFAULT_PASS=rabbit_secret_q10
RABBITMQ_URL=amqp://rabbit_admin:rabbit_secret_q10@rabbitmq:5672/
RABBITMQ_ORDERS_EXCHANGE=order_flow_exchange
RABBITMQ_ORDER_CREATED_QUEUE=order_created_queue
RABBITMQ_ORDER_STATUS_QUEUE=order_status_queue

# Configuración de Puertos para Docker Compose
API_PORT=8000
FRONTEND_PORT=5173
